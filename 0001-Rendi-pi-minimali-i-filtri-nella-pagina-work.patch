+          ? 'border-ink text-ink'
+          : 'border-transparent text-ink-muted hover:border-line-strong hover:text-ink'
       }`}
     >
       {label}
@@ -54,14 +55,12 @@ export async function WorkFilters({
   const hasFilter = Boolean(active.service ?? active.industry)
 
   return (
