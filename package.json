{
  "name": "portfolio-agenzia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "services:up": "docker compose up -d db minio minio-init",
    "services:down": "docker compose down",
    "tokens": "tsx scripts/generate-tokens.ts",
    "predev": "npm run tokens && npm run fonts",
    "prebuild": "npm run tokens && npm run fonts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "build:deploy": "npm run tokens && npm run fonts && npm run migrate && npm run build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@tailwindcss/postcss": "4.3.3",
    "cross-env": "7.0.3",
    "dotenv": "17.4.2",
    "graphql": "16.14.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "15.4.11",
    "next-intl": "4.13.6",
    "ogl": "1.0.11",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "6.20.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.4.11",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
