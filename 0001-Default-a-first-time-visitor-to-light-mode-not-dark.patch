From 0cd0568cfa4dd38edda58c7d092023a6f4e4ae65 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 16:12:11 +0000
Subject: [PATCH] Default a first-time visitor to light mode, not dark
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

DEFAULT_RESOLVED_THEME was 'dark'. The comment above it already
explains why this is the one place that matters: 'system' no longer
tracks prefers-color-scheme — a first visit lands on this value
regardless of OS setting, and stays there until the reader picks a
mode themselves via the switcher. One constant, no other call site
duplicates the literal.
---
 src/lib/theme.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/lib/theme.ts b/src/lib/theme.ts
index bf5f42f..8a8c910 100644
--- a/src/lib/theme.ts
+++ b/src/lib/theme.ts
@@ -20,7 +20,7 @@ export type ThemeMode = (typeof themeModes)[number]
 export const defaultThemeMode: ThemeMode = 'system'
 
 /** What a reader with no stored preference sees on their first visit. */
-export const DEFAULT_RESOLVED_THEME: 'light' | 'dark' = 'dark'
+export const DEFAULT_RESOLVED_THEME: 'light' | 'dark' = 'light'
 
 export function isThemeMode(value: unknown): value is ThemeMode {
   return typeof value === 'string' && (themeModes as readonly string[]).includes(value)
-- 
