From c92d9896fec544f95656547186a3f6e61ea7ff94 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 8 Sep 2026 19:01:35 +0000
Subject: [PATCH] Lay out /work's project grid the same way as the home page's
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The work index arranged cards in groups of three — one wide card then
two narrower ones offset by mt-64, repeating — while the home page's
"Progetti recenti" ProjectGrid block (its default variant) alternates
a wide card and a narrower one offset by mt-128 every two items. Two
different rhythms for the same kind of content, on a site that just
had the pages a click apart.

Copy the home page's alternation onto the work index: index % 2 (was
% 3), the same col-start-8/mt-128 offset and tablet col-start-3 on the
odd item, and the same 65vw tablet sizes hint ProjectGrid's default
variant uses.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X9ijuMVxdyw9LcC5DjUmXo
---
 src/app/(frontend)/[locale]/work/page.tsx | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/app/(frontend)/[locale]/work/page.tsx b/src/app/(frontend)/[locale]/work/page.tsx
index c5862bf..b1b581b 100644
--- a/src/app/(frontend)/[locale]/work/page.tsx
+++ b/src/app/(frontend)/[locale]/work/page.tsx
@@ -67,16 +67,16 @@ export default async function WorkIndexPage({ params, searchParams }: PageProps)
             <div
               key={project.id}
               className={
-                index % 3 === 0
+                index % 2 === 0
                   ? 'col-span-4 tablet:col-span-4 desktop:col-span-7'
-                  : 'col-span-4 tablet:col-span-3 desktop:col-span-5 desktop:mt-64'
+                  : 'col-span-4 tablet:col-span-4 tablet:col-start-3 desktop:col-span-5 desktop:col-start-8 desktop:mt-128'
               }
             >
               <ProjectCard
                 project={project}
                 headingLevel="h2"
-                sizes="(min-width: 1180px) 55vw, (min-width: 768px) 60vw, 100vw"
-                aspect={index % 3 === 0 ? 'aspect-[4/3]' : 'aspect-[3/4]'}
+                sizes="(min-width: 1180px) 55vw, (min-width: 768px) 65vw, 100vw"
+                aspect={index % 2 === 0 ? 'aspect-[4/3]' : 'aspect-[3/4]'}
               />
             </div>
           ))}
