diff --git a/src/lib/format.ts b/src/lib/format.ts
new file mode 100644
index 0000000..604e910
--- /dev/null
+++ b/src/lib/format.ts
@@ -0,0 +1,9 @@
+/**
+ * A project's year, optionally spanning several — "2020" on its own, or
+ * "2020–2024" when `yearEnd` is set and actually differs. An en dash, not a
+ * hyphen: the same mark the rest of the site's running text uses for a range.
+ */
+export function formatYearRange(year: number, yearEnd?: number | null): string {
+  if (!yearEnd || yearEnd === year) return String(year)
+  return `${year}–${yearEnd}`
+}
diff --git a/src/migrations/20260902_120032_add_project_year_end.ts b/src/migrations/20260902_120032_add_project_year_end.ts
new file mode 100644
index 0000000..e24fa27
--- /dev/null
+++ b/src/migrations/20260902_120032_add_project_year_end.ts
@@ -0,0 +1,20 @@
+import { MigrateUpArgs, MigrateDownArgs, sql } from '@payloadcms/db-postgres'
+
+/**
+ * Adds the optional `yearEnd` field to `projects`, on both the live table and
+ * its draft-version counterpart — `year_end` / `version_year_end`, `numeric`
+ * to match `year` / `version_year` right next to it. Hand-written rather than
+ * generated by `payload migrate:create`: a plain column addition, same as
+ * `20260824_170500_add_gallery_variant`.
+ */
+export async function up({ db, payload, req }: MigrateUpArgs): Promise<void> {
+  await db.execute(sql`
+   ALTER TABLE "projects" ADD COLUMN IF NOT EXISTS "year_end" numeric;
+  ALTER TABLE "_projects_v" ADD COLUMN IF NOT EXISTS "version_year_end" numeric;`)
+}
+
+export async function down({ db, payload, req }: MigrateDownArgs): Promise<void> {
+  await db.execute(sql`
+   ALTER TABLE "projects" DROP COLUMN IF EXISTS "year_end";
+  ALTER TABLE "_projects_v" DROP COLUMN IF EXISTS "version_year_end";`)
+}
