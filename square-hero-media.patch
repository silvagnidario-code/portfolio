From 014c49d0de92d260d937d3be59a0655deb2055f4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 1 Sep 2026 17:37:47 +0000
Subject: [PATCH] Keep full-bleed hero visuals square-cornered
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Three spots got rounded corners along with the rest of the site's
media, but they're edge-to-edge banners, not content sitting in the
page grid: the case-study cover image, the default hero's cover
image, and the media block's own default (edge-to-edge) variant.
They should read the same as the fullscreen hero background — square,
not rounded like a photo in a gallery or grid.
---
 src/app/(frontend)/[locale]/work/[slug]/page.tsx |  9 +++------
 src/components/blocks/hero.tsx                   |  4 +++-
 src/components/blocks/media-block.tsx            | 13 ++++++-------
 3 files changed, 12 insertions(+), 14 deletions(-)

diff --git a/src/app/(frontend)/[locale]/work/[slug]/page.tsx b/src/app/(frontend)/[locale]/work/[slug]/page.tsx
index e88d2f7..c494eb8 100644
--- a/src/app/(frontend)/[locale]/work/[slug]/page.tsx
+++ b/src/app/(frontend)/[locale]/work/[slug]/page.tsx
@@ -104,13 +104,10 @@ export default async function CaseStudyPage({ params }: PageProps) {
       </header>
 
       {project.heroMedia ? (
+        // Edge-to-edge banner, same role as the hero — square-cornered like
+        // any other full-bleed visual, not rounded like content in the grid.
         <figure className="mb-96">
-          <MediaImage
-            media={project.heroMedia}
-            sizes="100vw"
-            priority
-            className="w-full rounded-glass-lg"
-          />
+          <MediaImage media={project.heroMedia} sizes="100vw" priority className="w-full" />
         </figure>
       ) : null}
 
diff --git a/src/components/blocks/hero.tsx b/src/components/blocks/hero.tsx
index e1ca86e..91da49d 100644
--- a/src/components/blocks/hero.tsx
+++ b/src/components/blocks/hero.tsx
@@ -98,10 +98,12 @@ export function Hero({ block }: { block: HeroBlock }) {
   return (
     <BlockSection settings={settings}>
       <div className="page-grid">{text}</div>
+      {/* Edge-to-edge like the videoFullscreen variant above — a hero banner,
+          not content in the grid — so it stays square-cornered too. */}
       <figure className="mt-96">
         <HoverDistortion
           src={typeof image === 'object' ? (image?.url ?? '') : ''}
-          className="aspect-[16/9] w-full overflow-hidden rounded-glass-lg"
+          className="aspect-[16/9] w-full overflow-hidden"
         >
           <MediaImage media={image} sizes="100vw" priority className="h-full w-full object-cover" />
         </HoverDistortion>
diff --git a/src/components/blocks/media-block.tsx b/src/components/blocks/media-block.tsx
index ddf0969..9da0c30 100644
--- a/src/components/blocks/media-block.tsx
+++ b/src/components/blocks/media-block.tsx
@@ -16,7 +16,9 @@ function Caption({ children }: { children?: string | null }) {
 /**
  * Media, four variants. The layout containers stay square-cornered — content
  * is paper — but the photo or video itself carries `rounded-glass-lg`, same
- * as the navbar: see `radius` in `tokens/brand.ts`.
+ * as the navbar: see `radius` in `tokens/brand.ts`. The one exception is the
+ * default variant below, which runs edge-to-edge like the hero rather than
+ * sitting in the grid — that one stays square too.
  */
 export function MediaBlock({ block }: { block: MediaBlockType }) {
   const { variant, items, video, poster, before, after, caption, settings } = block
@@ -140,12 +142,9 @@ export function MediaBlock({ block }: { block: MediaBlockType }) {
   return (
     <BlockSection settings={settings}>
       <figure>
-        <MediaImage
-          media={first?.media}
-          sizes="100vw"
-          className="w-full rounded-glass-lg"
-          controls="hover"
-        />
+        {/* Edge-to-edge, no page-margin — this reads as a full-bleed banner
+            like the hero, not a photo in the flow, so it stays square. */}
+        <MediaImage media={first?.media} sizes="100vw" className="w-full" controls="hover" />
         <Caption>{first?.caption ?? caption}</Caption>
       </figure>
     </BlockSection>
-- 
2.43.0

