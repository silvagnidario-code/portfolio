From e996bea54d14ce8b2568a065258da7f957a09caa Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 3 Sep 2026 09:18:33 +0000
Subject: [PATCH] Uniforma l'interlinea di tutti i testi (titoli, body,
 caption) a 1.3
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Ogni grado tipografico — display, h1, h2, h3, body-lg, body, caption —
usava un line-height diverso (da 1.15 a 1.4). Ora condividono lo stesso
rapporto 1.3, così l'interlinea è coerente su tutti i testi del sito,
non solo sui paragrafi.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UmW6Wc96uzqk7ZGnbtDBfz
---
 src/styles/tokens.generated.css | 10 +++++-----
 src/tokens/brand.ts             | 10 +++++-----
 2 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/src/styles/tokens.generated.css b/src/styles/tokens.generated.css
index a47c917..80f7a9f 100644
--- a/src/styles/tokens.generated.css
+++ b/src/styles/tokens.generated.css
@@ -62,19 +62,19 @@
 
   /* Typography */
   --fs-display: clamp(2.75rem, 1.0833rem + 7.4074vw, 7.75rem);
-  --lh-display: 1.15;
+  --lh-display: 1.3;
   --ls-display: 0em;
   --fw-display: 300;
   --fs-h1: clamp(2.125rem, 1.3333rem + 3.5185vw, 4.5rem);
-  --lh-h1: 1.15;
+  --lh-h1: 1.3;
   --ls-h1: 0em;
   --fw-h1: 300;
   --fs-h2: clamp(1.6875rem, 1.25rem + 1.9444vw, 3rem);
-  --lh-h2: 1.2;
+  --lh-h2: 1.3;
   --ls-h2: 0em;
   --fw-h2: 400;
   --fs-h3: clamp(1.375rem, 1.1667rem + 0.9259vw, 2rem);
-  --lh-h3: 1.25;
+  --lh-h3: 1.3;
   --ls-h3: 0em;
   --fw-h3: 400;
   --fs-body-lg: clamp(1.125rem, 1.0417rem + 0.3704vw, 1.375rem);
@@ -86,7 +86,7 @@
   --ls-body: 0em;
   --fw-body: 400;
   --fs-caption: clamp(0.75rem, 0.7292rem + 0.0926vw, 0.8125rem);
-  --lh-caption: 1.4;
+  --lh-caption: 1.3;
   --ls-caption: 0.12em;
   --fw-caption: 500;
   /* Optical compensation, overridden for CJK below */
diff --git a/src/tokens/brand.ts b/src/tokens/brand.ts
index 4458d81..184d515 100644
--- a/src/tokens/brand.ts
+++ b/src/tokens/brand.ts
@@ -78,13 +78,13 @@ export type TypeGrade = {
  * only 300, 400 and 500 exist.
  */
 export const typeScale = {
-  display: { min: 44, max: 124, lineHeight: 1.15, tracking: 0, weight: 300 },
-  h1: { min: 34, max: 72, lineHeight: 1.15, tracking: 0, weight: 300 },
-  h2: { min: 27, max: 48, lineHeight: 1.2, tracking: 0, weight: 400 },
-  h3: { min: 22, max: 32, lineHeight: 1.25, tracking: 0, weight: 400 },
+  display: { min: 44, max: 124, lineHeight: 1.3, tracking: 0, weight: 300 },
+  h1: { min: 34, max: 72, lineHeight: 1.3, tracking: 0, weight: 300 },
+  h2: { min: 27, max: 48, lineHeight: 1.3, tracking: 0, weight: 400 },
+  h3: { min: 22, max: 32, lineHeight: 1.3, tracking: 0, weight: 400 },
   bodyLg: { min: 18, max: 22, lineHeight: 1.3, tracking: 0.01, weight: 400 },
   body: { min: 16, max: 18, lineHeight: 1.3, tracking: 0, weight: 400 },
-  caption: { min: 12, max: 13, lineHeight: 1.4, tracking: 0.12, weight: 500, uppercase: true },
+  caption: { min: 12, max: 13, lineHeight: 1.3, tracking: 0.12, weight: 500, uppercase: true },
 } as const satisfies Record<string, TypeGrade>
 
 export type TypeGradeName = keyof typeof typeScale
-- 
2.43.0

