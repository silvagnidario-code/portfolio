# Production environment.
#
# Copy to `.env` on the server, fill every value, then:
#   chmod 600 .env
#
# This file must sit OUTSIDE the web root. After the first deploy, check it:
#   curl -i https://your-domain.example/.env      # must answer 404, never 200
#
# Nothing here belongs in git. `.env` is ignored; this example is not, so keep
# it free of real values.

# ---------------------------------------------------------------------------
# Public address of the site
# ---------------------------------------------------------------------------
# Also drives the canonical URLs, the hreflang alternates, the sitemap and the
# allowed CORS/CSRF origin. Must be the address readers actually type, with the
# scheme and no trailing slash.
#
# WARNING: every NEXT_PUBLIC_* variable is compiled into the JavaScript bundle
# and visible to anyone. Never give a secret that prefix.
NEXT_PUBLIC_SERVER_URL=https://your-domain.example
NODE_ENV=production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Payload ships adapters for PostgreSQL, SQLite and MongoDB only — there is no
# MySQL/MariaDB adapter. Use the connection string of whichever you chose.
DATABASE_URI=postgres://user:password@host:5432/database

# ---------------------------------------------------------------------------
# Payload
# ---------------------------------------------------------------------------
# Signs the session tokens of the admin panel. Whoever holds it can forge an
# administrator session, so: at least 32 random characters, never shared between
# staging and production, never committed.
#   openssl rand -hex 32
# Rotating it logs every editor out; nothing else breaks.
PAYLOAD_SECRET=

# Guards the draft-preview entry point, on top of the editor's own session.
# Rotating it only invalidates old preview links.
#   openssl rand -hex 16
PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Media storage (S3-compatible: Cloudflare R2, Backblaze B2, MinIO…)
# ---------------------------------------------------------------------------
# Use a token scoped to THIS BUCKET with read+write, never an account-wide key.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing: true for MinIO, false for R2 and most CDNs.
S3_FORCE_PATH_STYLE=false
# Public base URL the files are served from — the CDN domain in production.
# It must be reachable from a browser, and it is what next/image is allowed to
# load from.
S3_PUBLIC_URL=https://media.your-domain.example

# ---------------------------------------------------------------------------
# Transactional email — the brief form
# ---------------------------------------------------------------------------
# A sending-only key, bound to the verified domain. Without it the form reports
# the failure instead of pretending the message was sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM=brief@your-domain.example
