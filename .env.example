# Copy to `.env` and fill in. Never commit `.env`.

NODE_ENV=development
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# PostgreSQL — matches the `db` service in docker-compose.yml
DATABASE_URI=postgres://portfolio:portfolio@localhost:5433/portfolio

# Payload — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Draft preview — generate with: openssl rand -hex 16
PREVIEW_SECRET=

# Media storage.
# Local development points at the `minio` service in docker-compose.yml;
# production points at Cloudflare R2 using the exact same variables.
S3_BUCKET=portfolio-media
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=portfolio
S3_SECRET_ACCESS_KEY=portfolio-secret
S3_FORCE_PATH_STYLE=true
# Public base URL files are served from (the CDN domain in production).
S3_PUBLIC_URL=http://localhost:9000/portfolio-media

# Phase 7 — transactional email
# RESEND_API_KEY=
